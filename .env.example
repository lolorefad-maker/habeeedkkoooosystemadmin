# Copy to .env (never commit it). Values for running Lounge OS yourself; on Render set them in the dashboard.

# local = shop PC on the LAN (embedded database, demo data on by default)
# cloud = online server (requires DATABASE_URL + LOUNGE_ACCESS_CODE, no demo data)
LOUNGE_MODE=local

# Postgres connection string. Empty = embedded database in LOUNGE_DATA_DIR.
DATABASE_URL=

# Where the embedded database lives (back this folder up if you use it).
LOUNGE_DATA_DIR=./.data

# Long random string. Empty = generated once and stored in LOUNGE_DATA_DIR.
JWT_SECRET=

# Shop code each device enters once before the login screen (required in cloud mode, 6+ characters).
LOUNGE_ACCESS_CODE=

# First start without demo data: the owner account (PIN 6–8 digits in cloud mode).
LOUNGE_OWNER_NAME=
LOUNGE_OWNER_PIN=

# true/false. Default: false in cloud mode, true in local mode.
LOUNGE_SEED_DEMO=

PORT=4000
